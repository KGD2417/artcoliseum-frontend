{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://artcoliseum-backend-production.up.railway.app/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://artcoliseum-backend-production.up.railway.app/ws/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://artcoliseum-backend-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/((?!ar-launcher\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
